CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_FREERTOS_HZ=1000
# app_main brings up esp_lcd, the first framebuffer draw, and the Berry VM on
# one task — the 3584-byte default overflows. Give it real headroom.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# api.anthropic.com serves a cross-signed chain (GTS Root R4 x GlobalSign);
# without this the crt bundle rejects it with "No matching trusted root".
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
# TLS handshakes can run long on a busy core 0 and starve IDLE0 past the
# default 5 s watchdog (this bit us badly on the pre-S3 board).
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15
# Hosyond/clone boards ship BOYA flash chips; the generic driver works but
# the dedicated one enables proper suspend/resume support.
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y

# El S3 llega a 240 MHz y venía a 160: es 1,5x gratis en todo lo que
# depende de la CPU — el handshake TLS, la cadena de Markov y la cara.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
