CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_FREERTOS_HZ=1000
# app_main brings up esp_lcd, the first framebuffer draw, and the Berry VM on
# one task — the 3584-byte default overflows. Give it real headroom.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# api.anthropic.com serves a cross-signed chain (GTS Root R4 x GlobalSign);
# without this the crt bundle rejects it with "No matching trusted root".
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
# TLS handshakes can run long on a busy core 0 and starve IDLE0 past the
# default 5 s watchdog (this bit us badly on the pre-S3 board).
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15
# Hosyond/clone boards ship BOYA flash chips; the generic driver works but
# the dedicated one enables proper suspend/resume support.
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y

# cJSON recurses ~96 bytes of stack per nesting level and defaults to allowing
# 1000 -- about 96 KB. The bus task has 6144 and parses brain replies inline,
# so a document 64 levels deep walks off the end of it, and the canary is only
# checked at a context switch. 20 is past anything our own formats need.
CONFIG_CJSON_NESTING_LIMIT=20

# TLS session tickets. Without them every reconnect after an idle drop pays a
# full handshake (~1.9 s measured on the S3) instead of a resumed one. This is
# also what makes esp_http_client_config_t::save_client_session exist at all.
CONFIG_ESP_TLS_CLIENT_SESSION_TICKETS=y
CONFIG_MBEDTLS_CLIENT_SSL_SESSION_TICKETS=y
